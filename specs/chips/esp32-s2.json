      "A{n}": "analog alias, board-specific",
      "SDA / SCL": "board/framework default I2C, board-specific (ESP32 can route I2C to almost any GPIO)",
      "MOSI/MISO/SCK/SS, COPI/CIPO/CS": "board/framework default SPI",
      "LED / LED_BUILTIN": "board-specific",
      "VP / VN": "classic ESP32 only: GPIO36 / GPIO39 (SENSOR_VP/VN)"
    },
